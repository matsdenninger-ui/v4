<!-- ASCEND DASHBOARD — v15 · 2026-07-31 · Cloud-Sync über /api/state (Vercel + Upstash Redis) ergänzt, additiv zu localStorage -->
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ascend — Self-Improvement Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<style>
:root{
  --bg:#000000;
  --surface:#121118;
  --elev:#1a1824;
  --border:#332f45;
  --border-soft:#211f2d;
  --text:#F5F3FA;
  --dim:#B7A9DC;
  --faint:#6f6785;
  --ac:#9B5DE5;
  --ac-2:#7C3FC4;
  --ac-light:#C9A6F5;
  --ac-soft:rgba(155,93,229,.13);
  --sec:#F15A29;
  --sec-light:#FF8C42;
  --sec-soft:rgba(241,90,41,.13);
  --mint:#34D399;
  --mint-soft:rgba(52,211,153,.14);
  --rose:#F87171;
  --sky:#60A5FA;
  --radius:18px;
  --radius-sm:11px;
  --shadow:0 10px 34px rgba(0,0,0,.55);
  --sidebar-w:256px;
  --font-display:"Archivo",system-ui,sans-serif;
  --font-body:"Inter",system-ui,sans-serif;
  --theme-transition:background-color 1.4s ease, border-color 1.4s ease, box-shadow 1.4s ease, color 1.4s ease;
}
/* ---------- Tageszeit-Farbverlauf ---------- */
/* Morgens: Lila -> Orange (Standard, s. :root oben) */
:root[data-period="day"]{
  --dim:#A9C6E8;
  --ac:#3B82F6;
  --ac-2:#2563EB;
  --ac-light:#93C5FD;
  --ac-soft:rgba(59,130,246,.13);
  --sec:#22C55E;
  --sec-light:#4ADE80;
  --sec-soft:rgba(34,197,94,.13);
  }
:root[data-period="evening"]{
  --dim:#C9C2E8;
  --ac:#5B7CFA;
  --ac-2:#364FC7;
  --ac-light:#A5B4FC;
  --ac-soft:rgba(91,124,250,.14);
  --sec:#F5D67B;
  --sec-light:#FDE68A;
  --sec-soft:rgba(245,214,123,.14);
  }
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  font-size:15px;
  line-height:1.55;
  min-height:100vh;
  position:relative;
}
body::before{
  content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(ellipse 800px 650px at 10% -5%, var(--ac-soft) 0%, transparent 55%),
    radial-gradient(ellipse 700px 600px at 100% 100%, var(--sec-soft) 0%, transparent 55%);
  transition:background 1.6s ease;
}
.main,.modal,.toasts{position:relative;z-index:1}
::selection{background:var(--ac-soft)}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,textarea,select{
  font-family:inherit;font-size:14px;color:var(--text);
  background:var(--bg);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:9px 12px;outline:none;
  transition:border-color .15s, box-shadow .15s;
}
input:focus,textarea:focus,select:focus{border-color:var(--ac);box-shadow:0 0 0 3px var(--ac-soft)}
:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
input:focus-visible,textarea:focus-visible,select:focus-visible{outline:none}
textarea{resize:vertical;min-height:90px;width:100%}
::placeholder{color:var(--faint,#6B7280)}

/* ---------- Layout: Sidebar zum Ausklappen (transparent) ---------- */
.burger{
  position:fixed;top:16px;left:16px;z-index:70;
  width:44px;height:44px;border-radius:12px;
  background:rgba(20,18,28,.55);border:1px solid var(--border-soft);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  display:grid;place-items:center;
  transition:background .2s ease,opacity .35s ease,transform .35s ease;
  opacity:1;
}
.burger:hover{background:rgba(20,18,28,.8)}
.burger.burger-hidden{opacity:0;transform:translateX(-10px);pointer-events:none}
.burger svg{width:20px;height:20px;stroke:var(--text)}
.scrim{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:59;backdrop-filter:blur(2px)}
.scrim.show{display:block}
.sidebar{
  position:fixed;inset:0 auto 0 0;width:var(--sidebar-w);
  background:rgba(10,9,15,.5);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-right:1px solid var(--border-soft);
  display:flex;flex-direction:column;padding:70px 16px 22px;gap:6px;z-index:60;
  transform:translateX(-105%);
  transition:transform .3s ease;
}
.sidebar.open{transform:none}
.brand{display:flex;align-items:center;gap:10px;padding:4px 10px 18px}
.brand-mark{
  width:34px;height:34px;border-radius:10px;flex:none;
  background:linear-gradient(135deg,var(--ac),var(--sec) 130%);
  display:grid;place-items:center;font-family:var(--font-display);
  font-weight:800;font-size:17px;color:#fff;letter-spacing:-.5px;
}
.brand h1{font-family:var(--font-display);font-size:19px;font-weight:700;letter-spacing:-.3px}
.brand span{display:block;font-size:11px;color:var(--dim);font-weight:400;font-family:var(--font-body);letter-spacing:.4px}
.nav{display:flex;flex-direction:column;gap:2px}
.nav button{
  display:flex;align-items:center;gap:11px;width:100%;
  padding:10px 12px;border-radius:var(--radius-sm);
  color:var(--dim);font-size:14px;font-weight:500;text-align:left;
  transition:background .15s,color .15s,box-shadow .2s;
  position:relative;border-left:2px solid transparent;
}
.nav button svg{width:18px;height:18px;flex:none;stroke:currentColor}
.nav button:hover{background:rgba(255,255,255,.05);color:var(--text)}
.nav button.active{
  background:var(--ac-soft);color:var(--ac);font-weight:600;
  border-left-color:var(--ac);
}
.side-foot{margin-top:auto;padding:14px 6px 2px;display:flex;flex-direction:column;gap:12px}

/* Level ring — signature element */
.level-card{
  background:rgba(20,18,28,.5);
  border:1px solid var(--border-soft);border-radius:var(--radius);
  padding:14px;display:flex;align-items:center;gap:13px;
}
.ring{position:relative;width:58px;height:58px;flex:none}
.ring svg{transform:rotate(-90deg);width:100%;height:100%}
.ring .track{stroke:#242e46;fill:none;stroke-width:5}
.ring .bar{stroke:url(#secGrad);fill:none;stroke-width:5;stroke-linecap:round;transition:stroke-dashoffset .6s cubic-bezier(.4,0,.2,1)}
.ring .lvl{
  position:absolute;inset:0;display:grid;place-items:center;
  font-family:var(--font-display);font-weight:800;font-size:19px;color:var(--sec);
}
.level-meta{min-width:0}
.level-meta b{font-family:var(--font-display);font-size:14px;font-weight:700;display:block}
.level-meta small{color:var(--dim);font-size:11.5px;display:block;margin-top:2px}
.xp-mini{height:4px;border-radius:2px;background:#242e46;margin-top:7px;overflow:hidden}
.xp-mini i{display:block;height:100%;border-radius:2px;background:linear-gradient(90deg,var(--sec),var(--sec-light));transition:width .5s}

.demo-btn{
  font-size:12px;color:var(--dim);padding:8px 10px;border-radius:var(--radius-sm);
  border:1px dashed var(--border);width:100%;transition:color .15s,border-color .15s;
  background:rgba(20,18,28,.3);
}
.demo-btn:hover{color:var(--text);border-color:var(--dim)}
.sync-box{border-top:1px solid var(--border-soft);padding-top:12px;margin-top:2px}
.sync-status{font-size:11px;color:var(--dim);margin-bottom:8px}
.sync-status.ok{color:var(--mint)}
.sync-status.err{color:var(--rose)}

.main{margin:0 auto;padding:22px 20px 80px;max-width:1200px}
.topbar{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:28px}
.topbar h2{
  font-family:var(--font-display);font-size:30px;font-weight:800;letter-spacing:-.7px;
  background:linear-gradient(90deg,var(--text) 55%,var(--ac));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.topbar .date{color:var(--dim);font-size:13.5px;margin-top:3px}

.page{display:none;animation:fade .25s ease}
.page.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.grid{display:grid;gap:24px}
.stack{display:flex;flex-direction:column;gap:24px}
.g2{grid-template-columns:1fr 1fr}
.g3{grid-template-columns:repeat(3,1fr)}
.span2{grid-column:span 2}

.card{
  position:relative;
  background:var(--surface);
  border:1px solid var(--border-soft);
  border-radius:14px;padding:24px 26px;box-shadow:0 4px 16px rgba(0,0,0,.25);
  transition:border-color .2s,box-shadow .2s;
  overflow:hidden;
}
.card:hover{border-color:var(--border)}
.card h3{
  font-family:var(--font-display);font-size:15.5px;font-weight:700;color:var(--text);
  letter-spacing:-.2px;margin-bottom:4px;display:flex;align-items:center;gap:9px;
}
.card h3 .tag{
  font-family:var(--font-body);font-size:10.5px;font-weight:600;letter-spacing:.6px;
  text-transform:uppercase;color:var(--dim);background:var(--elev);
  padding:3px 8px;border-radius:20px;margin-left:auto;
}
.card .sub{color:var(--dim);font-size:12.5px;margin-bottom:14px}
.empty{
  color:var(--dim);font-size:13px;text-align:center;padding:22px 10px;
  border:1px dashed var(--border);border-radius:var(--radius-sm);line-height:1.6;
}
.empty b{color:var(--text);font-weight:600}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex;align-items:center;gap:7px;
  background:var(--ac);color:#fff;font-weight:600;font-size:13.5px;
  padding:9px 16px;border-radius:var(--radius-sm);
  transition:filter .15s,transform .1s,box-shadow .2s;
}
.btn:hover{filter:brightness(1.12)}
.btn:active{transform:scale(.97)}
.btn.ghost{background:var(--elev);color:var(--text);border:1px solid var(--border)}
.btn.ghost:hover{border-color:var(--dim)}
.btn.danger{background:var(--rose);color:#fff}
.btn.danger:hover{filter:brightness(1.1)}
.btn.violet{background:linear-gradient(120deg,var(--sec),var(--sec-light));color:#fff}
.btn.sm{padding:6px 11px;font-size:12.5px}
.icon-btn{
  width:30px;height:30px;border-radius:8px;display:grid;place-items:center;
  color:var(--dim);transition:background .15s,color .15s;flex:none;
}
.icon-btn:hover{background:var(--elev);color:var(--text)}
.icon-btn.del:hover{color:var(--rose)}
.icon-btn svg{width:15px;height:15px;stroke:currentColor}

/* ---------- Lists & checks ---------- */
.row-add{display:flex;gap:9px;margin-bottom:13px}
.row-add input{flex:1;min-width:0}
.check-list{display:flex;flex-direction:column;gap:7px}
.check-item{
  display:flex;align-items:center;gap:11px;padding:10px 12px;
  background:var(--elev);border-radius:var(--radius-sm);
  border:1px solid transparent;transition:border-color .15s;
}
.check-item:hover{border-color:var(--border)}
.check-item .txt{flex:1;min-width:0;font-size:14px;overflow-wrap:anywhere}
.draggable-item{position:relative;touch-action:none}
.drag-handle{
  width:20px;height:20px;flex:none;color:var(--faint);cursor:grab;
  display:grid;place-items:center;touch-action:none;transition:color .15s;
}
.drag-handle svg{width:15px;height:15px}
.drag-handle:hover{color:var(--dim)}
.draggable-item.dragging{
  cursor:grabbing;z-index:5;border-color:var(--ac);
  box-shadow:0 8px 20px rgba(0,0,0,.4);background:var(--surface);
}
.draggable-item.dragging .drag-handle{color:var(--ac);cursor:grabbing}
.check-item.done .txt{color:var(--dim);text-decoration:line-through}
.cbx{
  width:21px;height:21px;border-radius:7px;border:2px solid var(--border);
  display:grid;place-items:center;flex:none;transition:all .15s;background:none;
}
.cbx svg{width:12px;height:12px;stroke:#fff;stroke-width:3;opacity:0;transition:opacity .1s}
.cbx.on{background:var(--mint);border-color:var(--mint)}
.cbx.on svg{opacity:1}
.meta{font-size:11.5px;color:var(--dim)}

/* streak flame chip */
.streak{
  display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:700;
  color:var(--sec);background:var(--sec-soft);padding:3px 9px;border-radius:20px;flex:none;
}

/* ---------- Heatmap ---------- */
.heatmap-wrap{overflow-x:auto;padding-bottom:4px}
.heatmap{display:grid;grid-auto-flow:column;grid-template-rows:repeat(7,11px);gap:3px;width:max-content}
.hm-cell{width:11px;height:11px;border-radius:3px;background:#1b2336}
.hm-1{background:#2b3a63}.hm-2{background:#41549b}.hm-3{background:#6773d6}.hm-4{background:#98a3ff}
.hm-legend{display:flex;align-items:center;gap:5px;margin-top:10px;font-size:11px;color:var(--dim)}
.hm-legend .hm-cell{width:10px;height:10px}

/* ---------- Timer ---------- */
.timer{
  text-align:center;padding:10px 0 4px;
}
.timer .clock{
  font-family:var(--font-display);font-size:46px;font-weight:800;letter-spacing:1px;
  font-variant-numeric:tabular-nums;line-height:1.1;
}
.timer .clock.running{color:var(--mint)}
.timer .state{font-size:12px;color:var(--dim);letter-spacing:1.5px;text-transform:uppercase;margin:4px 0 16px}
.focus-stat{display:flex;justify-content:center;gap:26px;margin-top:18px;padding-top:15px;border-top:1px solid var(--border-soft)}
.focus-stat div{text-align:center}
.focus-stat b{font-family:var(--font-display);font-size:20px;font-weight:700;display:block;font-variant-numeric:tabular-nums}
.focus-stat small{color:var(--dim);font-size:11.5px}

/* ---------- Week board ---------- */
.week-board{display:grid;grid-template-columns:repeat(7,1fr);gap:9px}
.wb-day{background:var(--elev);border-radius:var(--radius-sm);padding:9px;min-height:120px;display:flex;flex-direction:column;gap:6px}
.wb-day.today{outline:1.5px solid var(--ac)}
.wb-day h5{font-size:11px;letter-spacing:.8px;text-transform:uppercase;color:var(--dim);text-align:center;margin-bottom:-2px}
.wb-date{font-size:9.5px;color:var(--faint);text-align:center;margin-bottom:2px}
.wb-item{font-size:12px;background:var(--surface);border:1px solid var(--border-soft);border-radius:7px;padding:5px 7px;display:flex;flex-direction:column;gap:3px;cursor:pointer}
.wb-item.done{color:var(--dim);text-decoration:line-through}
.wb-item.rolled{border-color:var(--sec)}
.wb-item-row{display:flex;gap:5px;align-items:flex-start}
.wb-time{font-size:9.5px;color:var(--sec);font-weight:600;text-decoration:none;display:inline-block}
.wb-add{font-size:15px;color:var(--dim);border:1px dashed var(--border);border-radius:7px;padding:2px;line-height:1.2}
.wb-add:hover{color:var(--text)}

/* ---------- Macros / bars ---------- */
.macro{margin-bottom:14px}
.macro .lab{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:5px}
.macro .lab b{font-weight:600}
.macro .lab span{color:var(--dim);font-variant-numeric:tabular-nums}
.bar{height:8px;background:var(--elev);border-radius:5px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:5px;transition:width .45s ease}
.bar .kcal{background:linear-gradient(90deg,var(--sec),#f2d68b)}
.bar .pro{background:linear-gradient(90deg,var(--ac),#aeb4ff)}
.bar .carb{background:linear-gradient(90deg,var(--sky),#93dbff)}
.bar .fat{background:linear-gradient(90deg,var(--rose),#ffa3b5)}
.macro-inputs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.macro-inputs label{font-size:11px;color:var(--dim);display:block;margin-bottom:3px}
.macro-inputs input{width:100%;padding:7px 9px;font-size:13px}

/* ---------- Hydration ---------- */
.glasses{display:flex;flex-wrap:wrap;gap:7px;margin:8px 0 14px}
.glass{
  width:34px;height:44px;border-radius:6px 6px 10px 10px;
  border:2px solid var(--border);position:relative;overflow:hidden;
  transition:border-color .2s;background:var(--bg);cursor:pointer;
}
.glass::after{
  content:"";position:absolute;inset:auto 0 0 0;height:0;
  background:linear-gradient(180deg,#6fcdf5,#3d9fd6);transition:height .3s ease;
}
.glass.full{border-color:var(--sky)}
.glass.full::after{height:82%}

/* ---------- Tables ---------- */
table{width:100%;border-collapse:collapse;font-size:13px}
th{
  text-align:left;font-size:10.5px;letter-spacing:.7px;text-transform:uppercase;
  color:var(--dim);font-weight:600;padding:7px 10px;border-bottom:1px solid var(--border-soft);
}
td{padding:8px 10px;border-bottom:1px solid var(--border-soft);font-variant-numeric:tabular-nums}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,.015)}

/* ---------- Score dial / recovery ---------- */
.dial{display:flex;align-items:center;gap:18px}
.dial .ring{width:88px;height:88px}
.dial .ring .lvl{font-size:23px}
.dial ul{list-style:none;font-size:12.5px;color:var(--dim);display:flex;flex-direction:column;gap:5px}
.dial ul b{color:var(--text);font-weight:600}

/* ---------- Mood ---------- */
.mood-row{display:flex;gap:8px;margin-bottom:14px}
.mood-btn{
  flex:1;font-size:23px;padding:9px 0;border-radius:var(--radius-sm);
  background:var(--elev);border:1.5px solid transparent;transition:all .15s;
  filter:grayscale(.6);opacity:.75;
}
.mood-btn:hover{filter:none;opacity:1}
.mood-btn.sel{border-color:var(--ac);background:var(--ac-soft);filter:none;opacity:1;transform:scale(1.05)}
.tags{display:flex;flex-wrap:wrap;gap:7px;margin:11px 0 14px}
.tag-chip{
  font-size:12px;padding:5px 12px;border-radius:20px;background:var(--elev);
  color:var(--dim);border:1px solid var(--border-soft);transition:all .15s;
}
.tag-chip.sel{background:var(--ac-soft);color:var(--ac);border-color:var(--ac)}
.slider-lab{display:flex;justify-content:space-between;font-size:12px;color:var(--dim);margin:9px 0 5px}
input[type=range]{width:100%;accent-color:var(--ac);padding:0;border:none;background:none}

/* ---------- Skill tree ---------- */
.skill-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px}
.skill-col h4{
  font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--dim);
  margin-bottom:9px;padding-bottom:7px;border-bottom:1px solid var(--border-soft);
}
.skill-node{
  background:var(--elev);border-radius:var(--radius-sm);padding:10px 12px;margin-bottom:8px;
  border:1px solid var(--border-soft);transition:border-color .2s;
}
.skill-node b{font-size:13px;font-weight:600;display:block;margin-bottom:6px}
.pips{display:flex;gap:4px}
.pip{width:100%;height:5px;border-radius:3px;background:#232d47}
.pip.on{background:linear-gradient(90deg,var(--sec),var(--sec-light))}
.skill-node small{font-size:10.5px;color:var(--dim);display:block;margin-top:5px}

/* ---------- Badges ---------- */
.badges{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.badge{
  background:var(--elev);border:1px solid var(--border-soft);border-radius:var(--radius);
  padding:15px 13px;text-align:center;transition:transform .15s,border-color .15s;
}
.badge .ico{font-size:27px;margin-bottom:7px;filter:grayscale(1);opacity:.35}
.badge b{font-size:12.5px;display:block;font-weight:600;color:var(--dim)}
.badge small{font-size:11px;color:var(--dim);opacity:.75;display:block;margin-top:3px;line-height:1.45}
.badge.unlocked{border-color:var(--sec-soft);background:linear-gradient(165deg,var(--elev),var(--sec-soft))}
.badge.unlocked .ico{filter:none;opacity:1}
.badge.unlocked b{color:var(--sec)}
.badge.unlocked:hover{transform:translateY(-2px)}
.rarity{font-size:9.5px;letter-spacing:.8px;text-transform:uppercase;font-weight:700;display:inline-block;margin-top:6px;padding:2px 8px;border-radius:10px}
.r-selten{background:rgba(96,165,250,.15);color:var(--sky)}
.r-episch{background:var(--ac-soft);color:var(--ac)}
.r-legendaer{background:var(--sec-soft);color:var(--sec)}

/* ---------- Goals ---------- */
.goal{background:var(--elev);border-radius:var(--radius-sm);padding:15px;margin-bottom:11px;border:1px solid var(--border-soft)}
.goal-head{display:flex;align-items:center;gap:9px;margin-bottom:9px}
.goal-head b{font-size:14px;font-weight:600;flex:1}
.goal-type{font-size:10px;letter-spacing:.7px;text-transform:uppercase;font-weight:700;padding:3px 9px;border-radius:12px;flex:none}
.t-fokus{background:var(--mint-soft);color:var(--mint)}
.t-lang{background:rgba(96,165,250,.14);color:var(--sky)}
.goal .bar{height:9px;margin:4px 0 8px}
.goal .bar i{background:linear-gradient(90deg,var(--mint),#8ce8c6)}
.milestones{display:flex;flex-direction:column;gap:5px;margin-top:9px}
.ms{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--dim);cursor:pointer}
.ms .cbx{width:17px;height:17px;border-radius:5px}
.ms.done{color:var(--text)}
.goal-link{font-size:11px;color:var(--ac);margin-top:8px;display:inline-block}
.goal-todos{margin-top:12px;padding-top:11px;border-top:1px solid var(--border-soft)}
.goal-todos-lab{font-size:10.5px;letter-spacing:.5px;text-transform:uppercase;color:var(--dim);margin-bottom:7px}

/* ---------- Journal ---------- */
.journal-hist{margin-top:16px;display:flex;flex-direction:column;gap:8px}
.jh-item{background:var(--elev);border-radius:var(--radius-sm);padding:11px 13px;font-size:12.5px}
.jh-item b{font-size:12px;color:var(--ac);display:block;margin-bottom:4px}
.jh-item p{color:var(--dim);white-space:pre-wrap}

/* ---------- Stats strip ---------- */
/* ---------- Hero card (personal greeting + day progress) ---------- */
.page-greet{margin-bottom:16px}
.page-greet-row{display:flex;align-items:center;gap:16px}
.greet-avatar{
  font-size:34px;flex:none;line-height:1;
  background:none;border:none;transition:transform .15s;
}
.greet-avatar:hover{transform:scale(1.12) rotate(-4deg)}
.greet-text{flex:1;min-width:0}
.greet-title{
  font-family:var(--font-display);font-weight:800;
  font-size:clamp(26px,4.6vw,40px);letter-spacing:-1px;line-height:1.12;
  background:linear-gradient(90deg,var(--text) 45%,var(--ac));
  -webkit-background-clip:text;background-clip:text;color:transparent;
  display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;
}
.hero-name{
  border-bottom:2px dashed var(--faint);cursor:pointer;color:var(--ac);
  transition:border-color .15s;
}
.hero-name:hover{border-color:var(--ac)}
.hero-name-edit-btn{
  color:var(--dim);font-size:13px;opacity:.5;transition:opacity .15s;
  -webkit-text-fill-color:var(--dim);
}
.hero-name-edit-btn:hover{opacity:1;color:var(--ac);-webkit-text-fill-color:var(--ac)}
.hero-name-input{
  font-family:var(--font-display);font-size:22px;font-weight:800;
  padding:2px 8px;width:180px;
}
.hero-date{font-size:13.5px;color:var(--dim);margin-top:4px}
.greet-ring{flex:none}
.ring.ac-ring .bar{stroke:url(#acGrad)}
.hero-time{display:none;padding-top:14px;max-width:420px}
.hero-time.show{display:block}
.hero-time-lab{display:flex;justify-content:space-between;font-size:12px;color:var(--dim);margin-bottom:6px}
.hero-time-lab span:first-child{color:var(--text);font-weight:600}
.hero-time-lab span:last-child{font-variant-numeric:tabular-nums;color:var(--sec)}
.hero-time .bar i{background:linear-gradient(90deg,var(--sec),var(--sec-light))}
.hero-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}
.hchip{
  display:flex;align-items:center;gap:7px;font-size:12px;color:var(--dim);
  background:var(--surface);border:1px solid var(--border-soft);
  border-radius:20px;padding:7px 13px;cursor:default;
}
.hchip b{color:var(--text);font-weight:600}
.hchip.clickable{cursor:pointer;transition:border-color .15s}
.hchip.clickable:hover{border-color:var(--ac)}

.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:26px}
.stat{
  position:relative;overflow:hidden;
  background:var(--surface);
  border:1px solid var(--border-soft);
  border-radius:14px;
  padding:16px 18px;
}
.stat b{font-family:var(--font-display);font-size:24px;font-weight:800;display:block;letter-spacing:-.5px;font-variant-numeric:tabular-nums;color:var(--text)}
.stat small{color:var(--dim);font-size:12px}
.stat .delta{font-size:11px;color:var(--mint);font-weight:600}

/* ---------- Report modal ---------- */
.modal{position:fixed;inset:0;z-index:80;display:none;place-items:center;background:rgba(5,8,15,.68);backdrop-filter:blur(3px);padding:20px}
.modal.open{display:grid}
.modal-box{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
  max-width:560px;width:100%;max-height:82vh;overflow:auto;padding:26px;box-shadow:var(--shadow);
  animation:pop .25s ease;
}
@keyframes pop{from{opacity:0;transform:scale(.96) translateY(8px)}to{opacity:1;transform:none}}
.modal-box h3{font-family:var(--font-display);font-size:19px;margin-bottom:4px}
.report-body{white-space:pre-wrap;font-size:13.5px;color:var(--dim);background:var(--bg);border:1px solid var(--border-soft);border-radius:var(--radius-sm);padding:16px;margin:15px 0;line-height:1.7}
.report-body b{color:var(--text)}

/* ---------- Toast ---------- */
.toasts{position:fixed;bottom:22px;right:22px;z-index:90;display:flex;flex-direction:column;gap:8px}
.toast{
  background:var(--elev);border:1px solid var(--border);color:var(--text);
  padding:10px 16px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;
  box-shadow:var(--shadow);display:flex;align-items:center;gap:9px;
  animation:toastIn .3s ease;
}
.toast .xp{color:var(--sec);font-weight:800;font-family:var(--font-display)}
.toast.out{animation:toastOut .3s ease forwards}
@keyframes toastIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}
@keyframes toastOut{to{opacity:0;transform:translateX(30px)}}

.chart-box{position:relative;height:230px}
.chart-box.tall{height:280px}
.pill-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.divider{height:1px;background:var(--border-soft);margin:16px 0}
.note{font-size:12px;color:var(--dim);line-height:1.6}
.corr-val{font-family:var(--font-display);font-weight:800;font-size:26px;letter-spacing:-.5px}
.corr-pos{color:var(--mint)} .corr-neg{color:var(--rose)} .corr-neu{color:var(--dim)}

/* ---------- Meal planner ---------- */
.disclaimer-note{
  font-size:11.5px;color:var(--rose);background:rgba(248,113,113,.08);
  border:1px solid rgba(248,113,113,.25);border-radius:var(--radius-sm);
  padding:9px 12px;line-height:1.55;margin-bottom:14px;
}
.macro-sub-note{font-size:11px;color:var(--faint);margin-top:2px}
.meal-card2{
  background:var(--elev);border:1px solid var(--border-soft);border-radius:var(--radius-sm);
  margin-bottom:10px;overflow:hidden;transition:border-color .15s;
}
.meal-card2:hover{border-color:var(--border)}
.meal-card2-head{display:flex;align-items:center;gap:12px;padding:12px 14px;cursor:pointer}
.meal-icon2{
  width:40px;height:40px;border-radius:12px;display:grid;place-items:center;
  font-size:19px;flex:none;
}
.meal-card2-title{flex:1;min-width:0}
.meal-card2-title b{font-size:13.5px;font-weight:600;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.meal-card2-title small{font-size:11.5px;color:var(--dim)}
.meal-slot-badge2{
  font-size:9.5px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;
  color:var(--ac);background:var(--ac-soft);padding:2px 7px;border-radius:10px;margin-left:6px;
}
.meal-kcal2{font-size:13px;font-weight:700;color:var(--ac);flex:none;font-variant-numeric:tabular-nums}
.meal-chevron2{width:16px;height:16px;color:var(--dim);transition:transform .2s;flex:none}
.meal-card2.open .meal-chevron2{transform:rotate(180deg)}
.meal-card2-body{display:none;padding:0 14px 15px}
.meal-card2.open .meal-card2-body{display:block;animation:fade .2s ease}
.meal-card2.eaten .meal-card2-head{background:linear-gradient(90deg,var(--mint-soft),transparent)}
.meal-card2.eaten .meal-icon2{filter:none}
.meal-card2.eaten .meal-card2-title b{color:var(--mint)}
.food-row2{display:flex;gap:10px;padding:6px 0;border-bottom:1px solid var(--border-soft);font-size:12.5px}
.food-row2:last-child{border-bottom:none}
.food-dot2{width:5px;height:5px;border-radius:50%;background:var(--ac);margin-top:6px;flex:none}
.food-name2{flex:1;color:var(--text)}
.food-detail2{color:var(--dim);font-size:11px;text-align:right;max-width:44%;line-height:1.4}
.tagrow2{display:flex;flex-wrap:wrap;gap:6px;margin:11px 0}
.mtag{font-size:10px;padding:2px 9px;border-radius:20px;font-weight:700;letter-spacing:.2px}
.mtag.mg{background:var(--mint-soft);color:var(--mint)}
.mtag.mb{background:rgba(96,165,250,.14);color:var(--sky)}
.mtag.ma{background:rgba(245,158,11,.14);color:#f0a93a}
.mtag.mp{background:var(--sec-soft);color:var(--sec)}
.meal-macro-row2{display:flex;gap:18px;font-size:12px;color:var(--dim);padding-top:9px;border-top:1px solid var(--border-soft)}
.meal-macro-row2 b{color:var(--text);font-variant-numeric:tabular-nums}
.meal-foot2{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:11px;padding-top:11px;border-top:1px solid var(--border-soft)}
.meal-foot2 .time-edit2{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--dim)}
.meal-foot2 input[type=time]{padding:5px 8px;font-size:12px}
.meal-shuffle-btn{
  display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;
  color:var(--dim);background:var(--bg);border:1px solid var(--border);border-radius:20px;
  padding:5px 11px;transition:color .15s,border-color .15s;
}
.meal-shuffle-btn:hover{color:var(--ac);border-color:var(--ac)}
.variant-dots2{display:flex;gap:3px;align-items:center;margin-left:auto;font-size:10.5px;color:var(--faint)}
.vdot{width:5px;height:5px;border-radius:50%;background:var(--border);flex:none}
.vdot.on{background:var(--ac)}
.meal-eat-check{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--dim);cursor:pointer;font-weight:600}
.meal-eat-check input{width:16px;height:16px;accent-color:var(--mint);cursor:pointer}

/* ---------- Supplement stack ---------- */
.supp-card2{
  background:var(--elev);border:1px solid var(--border-soft);border-radius:var(--radius-sm);
  padding:15px;margin-bottom:10px;transition:border-color .15s,opacity .15s;
}
.supp-card2:hover{border-color:var(--border)}
.supp-card2.taken{border-color:rgba(52,211,153,.35)}
.supp-head2{display:flex;align-items:flex-start;gap:12px;margin-bottom:9px}
.supp-ico2{
  width:38px;height:38px;border-radius:50%;display:grid;place-items:center;
  font-size:17px;flex:none;
}
.supp-name2{font-size:13.5px;font-weight:600;line-height:1.3}
.supp-dose2{font-size:11.5px;color:var(--ac);font-weight:700;margin-top:2px}
.supp-del2{margin-left:auto}
.supp-when2{font-size:11px;color:var(--dim);margin-bottom:7px}
.supp-body2{font-size:11.5px;color:var(--dim);line-height:1.55;margin-bottom:11px}
.supp-foot2{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding-top:11px;border-top:1px solid var(--border-soft);
}
.supp-take-check{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--dim);cursor:pointer}
.supp-take-check input{width:17px;height:17px;accent-color:var(--mint);cursor:pointer}
.supp-time-edit{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--dim)}
.supp-time-edit input[type=time]{padding:4px 7px;font-size:11.5px}

/* ---------- Responsive ---------- */
@media (max-width:1024px){
  .g3{grid-template-columns:1fr 1fr}
  .stat-strip{grid-template-columns:1fr 1fr}
  .week-board{grid-template-columns:repeat(4,1fr)}
}
@media (max-width:860px){
  .g2,.g3{grid-template-columns:1fr}
  .span2{grid-column:span 1}
  .topbar h2{font-size:24px}
  .week-board{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:480px){
  .stat-strip{grid-template-columns:1fr 1fr;gap:10px}
  .timer .clock{font-size:38px}
  .main{padding:18px 14px 60px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001s!important;transition-duration:.001s!important}
}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute">
  <defs>
    <linearGradient id="secGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" style="stop-color:var(--sec-light)"/><stop offset="100%" style="stop-color:var(--sec)"/>
    </linearGradient>
    <linearGradient id="acGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" style="stop-color:var(--ac-light)"/><stop offset="100%" style="stop-color:var(--ac)"/>
    </linearGradient>
  </defs>
</svg>

<!-- ================= SIDEBAR ================= -->
<button class="burger" id="burger" aria-label="Menü öffnen">
  <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
</button>
<div class="scrim" id="scrim"></div>
<aside class="sidebar" id="sidebar">
  <div class="brand">
    <div class="brand-mark">A</div>
    <div><h1>Ascend</h1><span id="versionTag">v15 · 31.07.2026</span></div>
  </div>
  <nav class="nav" id="nav">
    <button data-page="today" class="active">
      <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m6.4.6-1.4 1.4M21 12h-2M5 12H3m3-5-1.4-1.4M12 21a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z"/></svg>
      Today</button>
    <button data-page="nutrition">
      <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c0-3 2-5 5-5 0 3-2 5-5 5Zm0 0C12 5 10 3 7 3c0 3 2 5 5 5Zm0 0v2m-5.5 1C4 11 3 13 3 15c0 3.5 2.5 6 5.5 6 1.2 0 2.4-.4 3.5-1.2 1.1.8 2.3 1.2 3.5 1.2 3 0 5.5-2.5 5.5-6 0-2-1-4-3.5-4-1.9 0-3.5.8-5.5.8S8.4 11 6.5 11Z"/></svg>
      Nutrition</button>
    <button data-page="body">
      <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.5 6.5v11m11-11v11M4 9v6m16-6v6M6.5 12h11"/></svg>
      Body</button>
    <button data-page="mind">
      <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.5 3A6.5 6.5 0 0 0 5 14.2V17a2 2 0 0 0 2 2h1v2h6v-3.5a6.5 6.5 0 0 0 4-6A6.5 6.5 0 0 0 11.5 5 6.5 6.5 0 0 0 9.5 3Z"/></svg>
      Mind</button>
    <button data-page="progress">
      <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20V10m6 10V4m6 16v-7m4 7H2"/></svg>
      Progress</button>
    <button data-page="goals">
      <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>
      Goals</button>
  </nav>
  <div class="side-foot">
    <div class="level-card">
      <div class="ring">
        <svg width="58" height="58" viewBox="0 0 58 58"><circle class="track" cx="29" cy="29" r="25"/><circle class="bar" id="ringBar" cx="29" cy="29" r="25" stroke-dasharray="157" stroke-dashoffset="157"/></svg>
        <div class="lvl" id="ringLvl">1</div>
      </div>
      <div class="level-meta">
        <b id="lvlTitle">Novize</b>
        <small id="lvlXp">0 / 100 XP</small>
        <div class="xp-mini"><i id="xpMini" style="width:0%"></i></div>
      </div>
    </div>
    <button class="demo-btn" id="demoBtn">✦ Demo-Daten laden</button>
    <button class="demo-btn" id="resetBtn" style="border-color:rgba(248,113,113,.35);color:var(--rose)">🗑 Alles zurücksetzen</button>
    <div class="sync-box" id="syncBox">
      <div class="sync-status" id="syncStatus">☁️ Nicht verbunden</div>
      <div class="row-add" id="syncForm" style="margin-bottom:0">
        <input id="syncCode" type="password" placeholder="Sync-Code" style="font-size:12px;padding:7px 9px">
        <button class="btn sm" id="syncConnect">Verbinden</button>
      </div>
    </div>
  </div>
</aside>

<main class="main">
  <div class="topbar">
    <div>
      <h2 id="pageTitle">Today</h2>
      <div class="date" id="dateLabel"></div>
    </div>
  </div>

  <!-- ================= TODAY ================= -->
  <section class="page active" id="page-today">
    <div class="page-greet" id="pageGreet">
      <div class="page-greet-row">
        <button class="greet-avatar" id="heroAvatarBtn" data-act="hero-avatar" title="Avatar wechseln">🔥</button>
        <div class="greet-text">
          <h1 class="greet-title" id="heroGreetRow">
            <span id="heroGreetWord">Hallo</span>,
            <span class="hero-name" id="heroNameDisplay" data-act="hero-name-edit">dir</span><button class="hero-name-edit-btn" id="heroNameEditBtn" data-act="hero-name-edit" aria-label="Namen bearbeiten">✎</button>
          </h1>
          <div class="hero-date" id="heroDate"></div>
        </div>
        <div class="greet-ring">
          <div class="ring ac-ring" style="width:56px;height:56px">
            <svg width="56" height="56" viewBox="0 0 58 58"><circle class="track" cx="29" cy="29" r="25"/><circle class="bar" id="dayRingBar" cx="29" cy="29" r="25" stroke-dasharray="157" stroke-dashoffset="157"/></svg>
            <div class="lvl" id="dayRingPct" style="color:var(--ac);font-size:14px">0%</div>
          </div>
        </div>
      </div>
      <div class="hero-time" id="heroTime">
        <div class="hero-time-lab"><span>⏱ Fokus-Zeit für heutige Ziele</span><span id="heroTimeNums">0 / 0 Min.</span></div>
        <div class="bar"><i id="heroTimeBar" style="width:0%"></i></div>
      </div>
    </div>
    <div class="hero-chips" id="heroChips"></div>

    <div class="stat-strip">
      <div class="stat"><b id="stTodos">0/0</b><small>To-Dos erledigt</small></div>
      <div class="stat"><b id="stHabits">0/0</b><small>Habits heute</small></div>
      <div class="stat"><b id="stFocus">0,0 h</b><small>Fokuszeit heute</small></div>
      <div class="stat"><b id="stStreak">0</b><small>Längste Streak</small></div>
    </div>

    <div class="stack">
      <div class="card">
        <h3>Morgenroutine <span class="tag">+2 XP</span></h3>
        <p class="sub">Gewinne den Morgen, gewinne den Tag. Am Griff ⠿ ziehen, um die Reihenfolge zu ändern.</p>
        <div class="row-add">
          <input id="routineAMInput" placeholder="Eigenen Punkt hinzufügen …" maxlength="80">
          <button class="btn sm" data-act="routine-add" data-list="am">+</button>
        </div>
        <div class="check-list" id="routineAM"></div>
      </div>

      <div class="card">
        <h3>Weekly Planning Board</h3>
        <p class="sub">Wähle bestehende To-Dos aus deiner Liste unten für einen Tag aus. Löschen geht nur in der To-Do-Liste.</p>
        <div class="week-board" id="weekBoard"></div>
      </div>

      <div class="card">
        <h3>🎯 Aktuelle Fokus-Ziele</h3>
        <p class="sub">Woran du gerade arbeitest — direkt aus den Goals gespiegelt.</p>
        <div id="todayFocusGoals"></div>
      </div>

      <div class="card">
        <h3>Deep Work Timer <span class="tag">+1 XP / min</span></h3>
        <p class="sub">Eine Aufgabe. Kein Handy. Volle Konzentration.</p>
        <div class="timer">
          <div class="clock" id="clock">00:00:00</div>
          <div class="state" id="timerState">Bereit</div>
          <button class="btn violet" id="timerBtn">▶ Session starten</button>
          <div class="focus-stat">
            <div><b id="focusToday">0,0 h</b><small>Heute</small></div>
            <div><b id="focusWeek">0,0 h</b><small>Diese Woche</small></div>
            <div><b id="focusSessions">0</b><small>Sessions heute</small></div>
          </div>
        </div>
      </div>

      <div class="card">
        <h3>To-Do Liste <span class="tag">+5 XP</span></h3>
        <p class="sub">Was steht heute an? Am Griff ⠿ ziehen, um die Reihenfolge zu ändern.</p>
        <div class="row-add">
          <input id="todoInput" placeholder="Neue Aufgabe eintragen …" maxlength="120">
          <input id="todoMinutes" type="number" min="0" step="5" placeholder="Min." style="width:64px;flex:none">
          <button class="btn" id="todoAdd">+</button>
        </div>
        <div class="check-list" id="todoList"></div>
      </div>

      <div class="card">
        <h3>Habit Tracker <span class="tag">+10 XP</span></h3>
        <p class="sub">Kleine Handlungen, täglich wiederholt, verändern alles.</p>
        <div class="row-add">
          <input id="habitInput" placeholder="Neuen Habit anlegen, z. B. „10 Min. Lesen“ …" maxlength="60">
          <button class="btn" id="habitAdd">Anlegen</button>
