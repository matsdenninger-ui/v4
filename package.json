    $("todayFocusGoals").innerHTML = `<div class="empty">🎯 <b>Noch kein Fokus-Ziel.</b><br>
      <span class="hchip clickable" data-act="goto-goals" style="margin-top:8px;display:inline-flex">Jetzt auf der Goals-Seite anlegen →</span></div>`;
